# Prefer monorepo file: ../config/secrets.yml
# Or use this file next to the service (gitignored if named application-secrets.yml)
x:
  storage:
    type: s3
    s3:
      bucket: ${s3.bucket:x-storage-service}
      region: ${s3.region:ap-southeast-1}
      access-key: ${s3.access-key}
      secret-key: ${s3.secret-key}
